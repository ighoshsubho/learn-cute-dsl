+@dsl_user_op
+def tma_load_gather4(
+    tma_desc_ptr: Pointer,
+    smem_ptr: Pointer,
+    mbar_ptr: Pointer,
+    col_idx: Integer,
+    row0: Integer,
+    row1: Integer,
+    row2: Integer,
+    row3: Integer,
+    *,
+    cache_hint: Optional[Int64] = None,
+    loc=None,
+    ip=None,
+) -> None:
+    """
+    Asynchronous TMA load using gather4 mode (SM100+).
+
+    Gathers 4 non-contiguous rows from a 2D global memory tensor into a
+    contiguous 2D tile in shared memory. The TMA descriptor must be configured
+    for a 2D tensor with bounding box of 4 in the row dimension.
+
+    See the `PTX documentation <https://docs.nvidia.com/cuda/parallel-thread-execution/#data-movement-and-conversion-instructions-cp-async-bulk-tensor>`__
+    for the ``tile::gather4`` mode.
+
+    :param tma_desc_ptr: Pointer to the TMA descriptor (global memory)
+    :type tma_desc_ptr: Pointer
+    :param smem_ptr: Destination pointer in shared memory
+    :type smem_ptr: Pointer
+    :param mbar_ptr: Pointer to mbarrier in shared memory
+    :type mbar_ptr: Pointer
+    :param col_idx: Column coordinate in the 2D tensor
+    :type col_idx: Integer
+    :param row0: First row index to gather
+    :type row0: Integer
+    :param row1: Second row index to gather
+    :type row1: Integer
+    :param row2: Third row index to gather
+    :type row2: Integer
+    :param row3: Fourth row index to gather
+    :type row3: Integer
+    :param cache_hint: Optional L2 cache eviction hint
+    :type cache_hint: Optional[Int64]
+    """
+    arch: Arch = BaseDSL._get_dsl().get_arch_enum()
+    if arch.major < Arch.sm_100.major:
+        raise ValueError(
+            f"tma_load_gather4 requires SM100+, but got {arch.name}"
+        )
+
+    desc_i64 = tma_desc_ptr.toint(loc=loc, ip=ip).ir_value(loc=loc, ip=ip)
+    smem_i32 = smem_ptr.toint(loc=loc, ip=ip).ir_value(loc=loc, ip=ip)
+    mbar_i32 = mbar_ptr.toint(loc=loc, ip=ip).ir_value(loc=loc, ip=ip)
+    col_i32 = Int32(col_idx).ir_value(loc=loc, ip=ip)
+    r0_i32 = Int32(row0).ir_value(loc=loc, ip=ip)
+    r1_i32 = Int32(row1).ir_value(loc=loc, ip=ip)
+    r2_i32 = Int32(row2).ir_value(loc=loc, ip=ip)
+    r3_i32 = Int32(row3).ir_value(loc=loc, ip=ip)
+
+    if cache_hint is not None:
+        hint_i64 = Int64(cache_hint).ir_value(loc=loc, ip=ip)
+        llvm.inline_asm(
+            None,
+            [smem_i32, desc_i64, mbar_i32,
+             col_i32, r0_i32, r1_i32, r2_i32, r3_i32,
+             hint_i64],
+            "cp.async.bulk.tensor.2d.shared::cta.global.tile::gather4"
+            ".mbarrier::complete_tx::bytes.L2::cache_hint"
+            " [$0], [$1, {$3, $4, $5, $6, $7}], [$2], $8;",
+            "r,l,r,r,r,r,r,r,l",
+            has_side_effects=True,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    else:
+        llvm.inline_asm(
+            None,
+            [smem_i32, desc_i64, mbar_i32,
+             col_i32, r0_i32, r1_i32, r2_i32, r3_i32],
+            "cp.async.bulk.tensor.2d.shared::cta.global.tile::gather4"
+            ".mbarrier::complete_tx::bytes"
+            " [$0], [$1, {$3, $4, $5, $6, $7}], [$2];",
+            "r,l,r,r,r,r,r,r",
+            has_side_effects=True,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+
