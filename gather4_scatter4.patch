+    else:
+        llvm.inline_asm(
+            None,
+            [smem_i32, desc_i64, mbar_i32, mask_i16,
+             col_i32, r0_i32, r1_i32, r2_i32, r3_i32],
+            "cp.async.bulk.tensor.2d.shared::cluster.global.tile::gather4"
+            ".mbarrier::complete_tx::bytes.multicast::cluster"
+            " [$0], [$1, {$4, $5, $6, $7, $8}], [$2], $3;",
+            "r,l,r,h,r,r,r,r,r",
+            has_side_effects=True,
