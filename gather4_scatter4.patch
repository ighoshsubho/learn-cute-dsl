+////////////////////////////////////////////////////////////////////////////////////////////////////
+/// TMA_STORE SCATTER4: Initiates a TMA copy, in scatter4 mode, from shared memory to global memory
+/// Scatters a contiguous 2D tile from shared memory into 4 non-contiguous rows in global memory.
+/// Takes 5 coordinates: {col_idx, row0, row1, row2, row3}
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+struct SM100_TMA_STORE_SCATTER4
+{
+  CUTE_HOST_DEVICE static void
+  copy([[maybe_unused]] void const* desc_ptr,
+       [[maybe_unused]] void const* smem_ptr,
+       [[maybe_unused]] int32_t const& col_idx,
+       [[maybe_unused]] int32_t const& row0, [[maybe_unused]] int32_t const& row1,
+       [[maybe_unused]] int32_t const& row2, [[maybe_unused]] int32_t const& row3)
+  {
+#if defined(CUTE_ARCH_TMA_SM100_ENABLED)
+    uint64_t gmem_int_desc = reinterpret_cast<uint64_t>(desc_ptr);
